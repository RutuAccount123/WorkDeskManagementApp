# Copy to .env (never commit .env) or set these in your hosting panel.
# prod = do NOT use the dev settings and sample data
SPRING_PROFILES_ACTIVE=prod
PORT=8082
DB_URL=jdbc:postgresql://localhost:5432/workdesk
DB_USER=workdesk
DB_PASSWORD=change-me
# a long random value, at least 32 characters (e.g. from: openssl rand -base64 48)
WD_JWT_SECRET=
# first start only: the first admin account
WD_ADMIN_EMAIL=admin@company.com
WD_ADMIN_PASSWORD=
# the website(s) of your hosted frontend, comma separated
WD_CORS_ORIGINS=http://localhost:5173
# behind Nginx / a cloud load balancer set to: framework
FORWARD_HEADERS=none
